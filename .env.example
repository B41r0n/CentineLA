# Variables de entorno para CentineLA
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.

# Credenciales de Socrata (datos.gov.co) para descargar datos del IDEAM.
# Se requiere el app_token (recomendado; basta para datos abiertos)...
SODAPY_APP_TOKEN=

# ...o, en su lugar, usuario y contraseña de Socrata.
# SODAPY_USERNAME=
# SODAPY_PASSWORD=

# Credenciales de red WiFi para nodos IoT (futuro)
# WIFI_SSID=
# WIFI_PASSWORD=

# Token de Ubidots / MQTT para nodos IoT (futuro)
# UBIDOTS_TOKEN=
