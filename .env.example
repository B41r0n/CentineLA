# Variables de entorno para CentineLA
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.

# Credenciales de Socrata para descargar datos IDEAM desde datos.gov.co
SODAPY_USERNAME=
SODAPY_PASSWORD=

# (Opcional) app_token de Socrata para evitar rate limits estrictos
# SODAPY_APP_TOKEN=

# Credenciales de red WiFi para nodos IoT (futuro)
# WIFI_SSID=
# WIFI_PASSWORD=

# Token de Ubidots / MQTT para nodos IoT (futuro)
# UBIDOTS_TOKEN=
